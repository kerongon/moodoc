{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon@2x.png",
      "icons/moodle_docker_updated.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": "src-tauri/Info.plist",
      "exceptionDomain": "localhost"
    }
  },
  "productName": "Moodle Docker Manager",
  "mainBinaryName": "Moodle Docker Manager",
  "version": "0.1.0",
  "identifier": "com.moodoc.moodle-docker-manager",
  "plugins": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Moodle Docker Manager",
        "visible": false,
        "width": 1000,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 820,
        "resizable": true,
        "decorations": false,
        "minimizable": true,
        "maximizable": true,
        "fullscreen": false,
        "useHttpsScheme": true
      },
      {
        "label": "splashscreen",
        "title": "Loading...",
        "url": "splashscreen.html",
        "visible": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "decorations": false,
        "width": 600,
        "height": 400,
        "center": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}